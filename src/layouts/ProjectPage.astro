---
import { Image } from 'astro:assets';
import preview from '../assets/alonelab.jpg';
import type { Locale, Project } from '../content/types';
import { copy, homePath, projectPath } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const text = copy[locale];
---

<BaseLayout
  locale={locale}
  alternatePath={projectPath(locale === 'fr' ? 'en' : 'fr', project.slug)}
  title={`${project.name} — Rafael Marques`}
  description={project.summary}
>
  <article class="case-study container">
    <a class="back-link" href={`${homePath(locale)}#projects`}>
      <ArrowIcon direction="left" />
      {text.caseStudy.back}
    </a>
    <header class="case-heading" data-reveal>
      <p class="eyebrow">{project.category}</p>
      <h1>{project.name}</h1>
      <p>{project.summary}</p>
    </header>
    {project.slug === 'alonelab' && (
      <div class="case-preview" data-reveal data-reveal-delay="80">
        <Image
          src={preview}
          alt={
            locale === 'fr'
              ? 'Aperçu du site vitrine AloneLab'
              : 'AloneLab showcase website preview'
          }
          width={1200}
          height={680}
          format="webp"
          loading="eager"
        />
      </div>
    )}
    <div class="case-body">
      <div class="case-narrative">
        <section data-reveal>
          <h2>{text.caseStudy.context}</h2>
          <p>{project.context}</p>
        </section>
        <section data-reveal>
          <h2>{text.caseStudy.contribution}</h2>
          <ul class="contributions">
            {project.contribution.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
        <section data-reveal>
          <h2>{text.caseStudy.outcome}</h2>
          <p>{project.outcome}</p>
        </section>
      </div>
      <aside class="case-meta" data-reveal>
        <h2>{text.caseStudy.stack}</h2>
        <Skills items={project.technologies} />
        {project.url ? (
          <a
            class="button button-primary"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {text.projects.visit}
            <ArrowIcon direction="up-right" />
            <span class="sr-only">
              {' '}
              ({locale === 'fr' ? 'nouvel onglet' : 'new tab'})
            </span>
          </a>
        ) : (
          <p class="confidentiality-note">{text.caseStudy.confidentiality}</p>
        )}
      </aside>
    </div>
  </article>
  <Contact locale={locale} />
</BaseLayout>
