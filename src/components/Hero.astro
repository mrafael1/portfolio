---
import { profile } from '../content/profile';
import type { Locale } from '../content/types';
import { copy } from '../lib/content';
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = copy[locale].hero;
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="hero-copy" data-reveal>
    <p class="eyebrow">{text.label}</p>
    <h1 id="hero-heading">
      {text.heading[0]}
      <br />
      <span>{text.heading[1]}</span>
    </h1>
    <p class="hero-introduction">{text.introduction}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#contact">
        {text.contact}
        <ArrowIcon />
      </a>
      <a class="text-link" href="#projects">
        {text.projects}
        <ArrowIcon direction="down" />
      </a>
    </div>
    <p class="hero-location">{text.location}</p>
  </div>
  <div class="hero-proof" data-reveal data-reveal-delay="80">
    <ul role="list">
      {text.facts.map((fact, index) => (
        <li>
          <span class="proof-number" aria-hidden="true">
            0{index + 1}
          </span>
          {fact}
        </li>
      ))}
    </ul>
    <div class="hero-stack">{profile.primarySkills.join(' / ')}</div>
  </div>
</section>
