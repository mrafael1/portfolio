---
interface Props {
  direction?: 'right' | 'up-right' | 'left' | 'down';
}
const { direction = 'right' } = Astro.props;
const paths = {
  right: 'M4 10h12m-5-5 5 5-5 5',
  'up-right': 'M5 15 15 5M5 5h10v10',
  left: 'M16 10H4m5-5-5 5 5 5',
  down: 'M10 4v12m-5-5 5 5 5-5',
};
---

<svg
  class="arrow-icon"
  data-direction={direction}
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[direction]} />
</svg>
